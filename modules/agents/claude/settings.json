{
  "env": {
    "CLAUDE_CODE_ARTIFACT": "1",
    "CLAUDE_CODE_ENABLE_AUTO_MODE": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CODING_AGENT": "claude"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-opus-5-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/technical-writing.sh"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/t3-thread-name.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/technical-writing.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "engineering@hubermjonathan": true,
    "communication@hubermjonathan": true,
    "agents@hubermjonathan": true,
    "design-profile@hubermjonathan": true,
    "admin@hubermjonathan-work": true,
    "sso@hubermjonathan-work": true,
    "factory@hubermjonathan-work": true
  },
  "extraKnownMarketplaces": {
    "hubermjonathan": {
      "source": {
        "source": "github",
        "repo": "hubermjonathan/skills"
      },
      "autoUpdate": true
    },
    "hubermjonathan-work": {
      "source": {
        "source": "github",
        "repo": "hubermjonathan/skills-work"
      },
      "autoUpdate": true
    }
  },
  "viewMode": "focus",
  "effortLevel": "xhigh",
  "promptSuggestionEnabled": false,
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoCompactWindow": 500000
}
