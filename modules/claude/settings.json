{
  "env": {
    "CLAUDE_CODE_ENABLE_AUTO_MODE": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CODING_AGENT": "claude"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-opus-5-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/technical-writing.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/technical-writing.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "skills@hubermjonathan": true,
    "ou-bq-domain@ou-claude-plugins": true,
    "design-profile@hubermjonathan": true,
    "work@dot-work": true,
    "sso@dot-work": true
  },
  "extraKnownMarketplaces": {
    "hubermjonathan": {
      "source": {
        "source": "github",
        "repo": "hubermjonathan/skills"
      }
    },
    "ou-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "OfferUp/claude-plugins-ou"
      }
    },
    "dot-work": {
      "source": {
        "source": "github",
        "repo": "hubermjonathan/dot-work"
      }
    }
  },
  "outputStyle": "Concise",
  "viewMode": "focus",
  "effortLevel": "xhigh",
  "promptSuggestionEnabled": false,
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoCompactWindow": 500000
}
