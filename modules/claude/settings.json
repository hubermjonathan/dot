{
  "env": {
    "CLAUDE_CODE_ENABLE_AUTO_MODE": "1",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "Read(~/.claude/pipelines/**)",
      "Write(~/.claude/pipelines/**)",
      "Edit(~/.claude/pipelines/**)",
      "Bash(~/.claude/pipelines/bin/*)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr merge --auto *)",
      "Bash(gh pr create *)",
      "Bash(gh api *)",
      "Bash(gh ou promote *)",
      "Bash(git push *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git worktree *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/technical-writing.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/pipelines/bin/pipeline-session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/technical-writing.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/pipelines/bin/pipeline-advance.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "skills@hubermjonathan": true,
    "ou-bq-domain@ou-claude-plugins": true,
    "design-profile@hubermjonathan": true
  },
  "extraKnownMarketplaces": {
    "hubermjonathan": {
      "source": {
        "source": "github",
        "repo": "hubermjonathan/skills"
      }
    },
    "ou-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "OfferUp/claude-plugins-ou"
      }
    }
  },
  "outputStyle": "Concise",
  "viewMode": "focus",
  "effortLevel": "medium",
  "promptSuggestionEnabled": false,
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
