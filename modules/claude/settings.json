{
  "awsAuthRefresh": "aws sso login --profile dev",
  "editorMode": "normal",
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "arn:aws:bedrock:us-east-1:735354846484:application-inference-profile/bxi2s9x695ho",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "arn:aws:bedrock:us-east-1:735354846484:application-inference-profile/yoyhj0injypc",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "arn:aws:bedrock:us-east-1:735354846484:application-inference-profile/7o4asxwz6fc7",
    "ANTHROPIC_MODEL": "arn:aws:bedrock:us-east-1:735354846484:application-inference-profile/yoyhj0injypc",
    "ANTHROPIC_SMALL_FAST_MODEL": "arn:aws:bedrock:us-east-1:735354846484:application-inference-profile/bxi2s9x695ho",
    "AWS_PROFILE": "dev",
    "AWS_REGION": "us-east-1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "16384",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "MAX_THINKING_TOKENS": "1024",
    "OTEL_EXPORTER_OTLP_METRICS_ENDPOINT": "https://otlp.datadoghq.eu/v1/metrics",
    "OTEL_EXPORTER_OTLP_METRICS_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "delta",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_RESOURCE_ATTRIBUTES": "team=eng-connect,user.email=jon.huber@offerup.com"
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "repo": "JuliusBrussee/caveman",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostToolUse": [],
    "PostToolUseFailure": [],
    "PreToolUse": [],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"SessionStart\", \"additionalContext\": \"Auto-activate: invoke the caveman:caveman ultra skill before your first response. RENAME SESSION: per CLAUDE.md, rename to [PR#-]<1-5-word-kebab-task-desc> BEFORE first code change.\"}}'",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "cmux hook session-start",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "cmux hook stop",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "cmux hook prompt-submit",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "otelHeadersHelper": "~/.claude/otel-helper.sh",
  "permissions": {},
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 10,
    "type": "command"
  },
  "worktree": {
    "baseRef": "fresh"
  }
}
