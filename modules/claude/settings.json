{
  "awsAuthRefresh": "aws sso login --profile dev",
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "caveman@caveman": true,
    "claude-api@anthropic-agent-skills": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "ou-git-workflows@ou-claude-plugins": true,
    "playwright@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers-extended-cc@superpowers-extended-cc-marketplace": true,
    "superpowers@claude-plugins-official": true
  },
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "arn:aws:bedrock:us-east-1:735354846484:application-inference-profile/bxi2s9x695ho",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "arn:aws:bedrock:us-east-1:735354846484:application-inference-profile/yoyhj0injypc",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "arn:aws:bedrock:us-east-1:735354846484:application-inference-profile/7o4asxwz6fc7",
    "ANTHROPIC_MODEL": "arn:aws:bedrock:us-east-1:735354846484:application-inference-profile/yoyhj0injypc",
    "ANTHROPIC_SMALL_FAST_MODEL": "arn:aws:bedrock:us-east-1:735354846484:application-inference-profile/bxi2s9x695ho",
    "AWS_PROFILE": "dev",
    "AWS_REGION": "us-east-1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "16384",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "MAX_THINKING_TOKENS": "1024",
    "OTEL_EXPORTER_OTLP_METRICS_ENDPOINT": "https://otlp.datadoghq.eu/v1/metrics",
    "OTEL_EXPORTER_OTLP_METRICS_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "delta",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_RESOURCE_ATTRIBUTES": "team=eng-connect,user.email=jon.huber@offerup.com"
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "repo": "anthropics/skills",
        "source": "github"
      }
    },
    "aws-claude-code-plugins": {
      "source": {
        "repo": "aws-solutions-library-samples/guidance-for-claude-code-with-amazon-bedrock",
        "source": "github"
      }
    },
    "caveman": {
      "source": {
        "repo": "JuliusBrussee/caveman",
        "source": "github"
      }
    },
    "ou-claude-plugins": {
      "source": {
        "repo": "OfferUp/claude-plugins-ou",
        "source": "github"
      }
    },
    "superpowers-extended-cc-marketplace": {
      "source": {
        "repo": "pcvelz/superpowers",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostToolUse": [],
    "PostToolUseFailure": [],
    "PreToolUse": [],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"SessionStart\", \"additionalContext\": \"Auto-activate: invoke the 'caveman:caveman ultra' skill before your first response.\"}}'",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "cmux hook session-start",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "cmux hook stop",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "cmux hook prompt-submit",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "otelHeadersHelper": "~/.claude/otel-helper.sh",
  "permissions": {
    "allow": [
      "Bash(bq query:*)",
      "Bash(bq ls:*)",
      "Bash(bq show:*)",
      "Bash(bq head:*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(curl:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true
}