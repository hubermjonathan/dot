#!/bin/sh
REPO=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
# In ~/.dot.local, a line that starts with ~/ or / names a repo whose modules load beside dot's. Every other line is a skip.
conf=$(sed 's/#.*//' "$HOME/.dot.local" 2>/dev/null)
repos="$REPO $(echo "$conf" | sed -e "s|^[[:space:]]*~/|$HOME/|" -e '/^[[:space:]]*\//!d' | tr -s ' \t\n' ' ')"
skips=$(echo "$conf" | grep -v '^[[:space:]]*[~/]' | tr -s ' \t\n' ' ')
failures=0 shown=

skipped() { case " $skips " in *" $1 "*) ;; *) return 1 ;; esac; }
say() { [ "$shown" = "$mod" ] || echo "▸ $mod"; shown=$mod; printf '  %s\n' "$*"; }
fail() { say "✗ $*"; failures=$((failures + 1)); }
step() { skipped "$mod/$1" && return; say "$1"; sh -c "$2" || fail "$1 failed"; }
health() { skipped "$mod/$1" || sh -c "$2" </dev/null >/dev/null 2>&1 || fail "$1: $2"; }

link() { :; }; formula() { :; }; cask() { :; }; post_link() { :; }; provision() { :; }; check() { :; }

each_module() {
  [ $# -gt 0 ] || set -- $(for r in $repos; do (cd "$r/modules" 2>/dev/null && ls -d */module.sh 2>/dev/null); done | cut -d/ -f1 | sort -u)
  for mod; do
    found=
    for r in $repos; do
      dir=$r/modules/$mod f=$r/modules/$mod/module.sh
      [ -f "$f" ] || continue
      found=1
      if skipped "$mod"; then :
      elif sh -n "$f"; then cd "$dir" && . "$f"
      else fail "module.sh does not parse"; fi
    done
    [ -n "$found" ] || fail "no such module"
  done
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case $cmd in
link)
  link() {
    src=$dir/$1 dst=$2
    [ "$(readlink "$dst")" = "$src" ] && return
    mkdir -p "$(dirname "$dst")"
    if [ -e "$dst" ] && [ ! -L "$dst" ]; then
      bak=$HOME/.dotfiles-backup/$mod/$(basename "$dst").$(date -u +%Y%m%dT%H%M%S)
      mkdir -p "$(dirname "$bak")" && [ ! -e "$bak" ] && mv "$dst" "$bak" || { fail "could not back up $dst"; return; }
      say "moved $dst to $bak"
    fi
    ln -sfn "$src" "$dst" && say "linked $dst" || fail "could not link $dst"
  }
  post_link() { step "$@"; }
  each_module "$@" ;;
install)
  formula() {
    set -- $(for p; do skipped "$mod/$p" || echo "$p"; done)
    [ $# -eq 0 ] || [ "$*" = --cask ] || { say "brew install $*"; brew install "$@" || fail "brew install $* failed"; }
  }
  cask() { formula --cask "$@"; }
  provision() { step "$@"; }
  each_module "$@" ;;
status)
  if [ "${1:-}" = --orphans ]; then
    # A skipped module's links still count as declared.
    skips= declared=
    link() { declared="$declared$2
"; }
    each_module
    # Match links into any checkout or worktree of dot or a listed repo, by the repo's folder name.
    set --
    for n in dot $(for r in $repos; do echo "${r##*/}"; done | sed 1d); do set -- "$@" -o -lname "*/$n/modules/*" -o -lname "*/$n/*/modules/*"; done
    shift
    # The while loop runs in a subshell, so the last grep tells whether it printed an orphan.
    find "$HOME" \( -path "$HOME/Library" -o -name .Trash -o -name node_modules -o -name .git \) -prune -o -type l \( "$@" \) \
      -print 2>/dev/null | grep -vxF "$declared" |
      while IFS= read -r l; do printf '✗ orphan: %s -> %s\n' "$l" "$(readlink "$l")"; done | grep . && failures=1
  else
    link() {
      src=$dir/$1 dst=$2
      if [ ! -e "$dst" ] && [ ! -L "$dst" ]; then fail "$dst is missing"
      elif [ ! -L "$dst" ]; then fail "$dst is not a symlink"; diff -u "$src" "$dst"
      elif [ "$(readlink "$dst")" != "$src" ]; then fail "$dst points to $(readlink "$dst")"
      elif [ ! -e "$dst" ]; then fail "$dst is broken"; fi
    }
    post_link() { [ $# -lt 3 ] || health "$1" "$3"; }
    provision() { post_link "$@"; }
    check() { health "$@"; }
    for r in $repos; do [ -d "$r" ] || { mod='~/.dot.local'; fail "$r is missing"; }; done
    each_module "$@"
  fi
  [ $failures -gt 0 ] || echo "all healthy" ;;
*)
  echo "usage: dot link|install [module...] | dot status [--orphans | module...]" >&2; exit 1 ;;
esac
[ $failures -eq 0 ]
