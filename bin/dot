#!/bin/sh
REPO=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
# In ~/.dot.local, a line that starts with ~/ or / names a repo whose modules load beside dot's. Every other line is a skip.
conf=$(sed 's/#.*//' "$HOME/.dot.local" 2>/dev/null)
repos="$REPO $(echo "$conf" | sed -e "s|^[[:space:]]*~/|$HOME/|" -e '/^[[:space:]]*\//!d' | tr -s ' \t\n' ' ')"
skips=$(echo "$conf" | grep -v '^[[:space:]]*[~/]' | tr -s ' \t\n' ' ')
failures=0 shown=

skipped() { case " $skips " in *" $1 "*) ;; *) return 1 ;; esac; }
say() { [ "$shown" = "$mod" ] || echo "▸ $mod"; shown=$mod; printf '  %s\n' "$*"; }
fail() { say "✗ $*"; failures=$((failures + 1)); }
# Without a terminal, no one can answer a prompt, so a step that waits for one would stall the run. This ends
# the step's whole process group once the time is up.
limit='$t = shift; $p = fork // exit 1; unless ($p) { setpgrp; exec @ARGV; exit 127 } $SIG{ALRM} = sub { print STDERR "timed out after $t seconds\n"; kill TERM => -$p }; alarm $t; waitpid $p, 0; exit($? && 1)'
step() {
  skipped "$mod/$1" && return; say "$1"
  if [ -t 0 ]; then sh -c "$2"; else perl -e "$limit" "${DOT_STEP_SECONDS:-120}" sh -c "$2"; fi || fail "$1 failed"
}
health() { skipped "$mod/$1" || sh -c "$2" </dev/null >/dev/null 2>&1 || fail "$1: $2"; }

link() { :; }; formula() { :; }; cask() { :; }; post_link() { :; }; provision() { :; }; check() { :; }

each_module() {
  [ $# -gt 0 ] || set -- $(for r in $repos; do (cd "$r/modules" 2>/dev/null && ls -d */module.sh 2>/dev/null); done | cut -d/ -f1 | sort -u)
  for mod; do
    found=
    for r in $repos; do
      dir=$r/modules/$mod f=$r/modules/$mod/module.sh
      [ -f "$f" ] || continue
      found=1
      if skipped "$mod"; then :
      elif sh -n "$f"; then cd "$dir" && . "$f"
      else fail "module.sh does not parse"; fi
    done
    [ -n "$found" ] || fail "no such module"
  done
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case $cmd in
link)
  link() {
    src=$dir/$1 dst=$2
    [ "$(readlink "$dst")" = "$src" ] && return
    mkdir -p "$(dirname "$dst")"
    if [ -e "$dst" ] && [ ! -L "$dst" ]; then
      bak=$HOME/.dotfiles-backup/$mod/$(basename "$dst").$(date -u +%Y%m%dT%H%M%S)
      mkdir -p "$(dirname "$bak")" && [ ! -e "$bak" ] && mv "$dst" "$bak" || { fail "could not back up $dst"; return; }
      say "moved $dst to $bak"
    fi
    ln -sfn "$src" "$dst" && say "linked $dst" || fail "could not link $dst"
  }
  post_link() { step "$@"; }
  each_module "$@" ;;
install)
  formula() {
    set -- $(for p; do skipped "$mod/$p" || echo "$p"; done)
    [ $# -eq 0 ] || [ "$*" = --cask ] || { say "brew install $*"; brew install "$@" || fail "brew install $* failed"; }
  }
  cask() { formula --cask "$@"; }
  provision() { step "$@"; }
  each_module "$@" ;;
status)
  if [ "${1:-}" = --orphans ]; then
    # A skipped module's links still count as declared.
    skips= declared=
    link() { declared="$declared$2
"; }
    each_module
    # Match links into any checkout or worktree of dot or a listed repo, by the repo's folder name.
    set --
    for n in dot $(for r in $repos; do echo "${r##*/}"; done | sed 1d); do set -- "$@" -o -lname "*/$n/modules/*" -o -lname "*/$n/*/modules/*"; done
    shift
    # The while loop runs in a subshell, so the last grep tells whether it printed an orphan.
    find "$HOME" \( -path "$HOME/Library" -o -name .Trash -o -name node_modules -o -name .git \) -prune -o -type l \( "$@" \) \
      -print 2>/dev/null | grep -vxF "$declared" |
      while IFS= read -r l; do printf '✗ orphan: %s -> %s\n' "$l" "$(readlink "$l")"; done | grep . && failures=1
  else
    link() {
      src=$dir/$1 dst=$2
      if [ ! -e "$dst" ] && [ ! -L "$dst" ]; then fail "$dst is missing"
      elif [ ! -L "$dst" ]; then fail "$dst is not a symlink"; diff -u "$src" "$dst"
      elif [ "$(readlink "$dst")" != "$src" ]; then fail "$dst points to $(readlink "$dst")"
      elif [ ! -e "$dst" ]; then fail "$dst is broken"; fi
    }
    post_link() { [ $# -lt 3 ] || health "$1" "$3"; }
    provision() { post_link "$@"; }
    check() { health "$@"; }
    for r in $repos; do [ -d "$r" ] || { mod='~/.dot.local'; fail "$r is missing"; }; done
    each_module "$@"
  fi
  [ $failures -gt 0 ] || echo "all healthy" ;;
pull)
  changed=
  for r in $repos; do
    [ -e "$r/.git" ] || continue
    mod=${r##*/} old=$(git -C "$r" rev-parse HEAD)
    if [ "$(git -C "$r" branch --show-current)" != main ]; then fail "not on main"; continue; fi
    git -C "$r" fetch -q origin main && git -C "$r" merge -q --ff-only --autostash origin/main || { fail "could not fast-forward main"; continue; }
    # When uncommitted changes conflict with the new main, git keeps them in the stash and writes conflict
    # markers, which would break live config. Going back to main leaves the changes safe in the stash.
    [ -z "$(git -C "$r" ls-files -u)" ] ||
      { git -C "$r" reset -q --hard; fail "uncommitted changes conflicted with main, so they are in the stash"; }
    [ "$(git -C "$r" rev-parse HEAD)" = "$old" ] || changed="$changed $(git -C "$r" diff --name-only "$old" HEAD -- modules | cut -d/ -f2)"
  done
  mods=$(for m in $changed; do for r in $repos; do [ -f "$r/modules/$m/module.sh" ] && echo "$m"; done; done | sort -u)
  if [ -n "$mods" ]; then
    HOMEBREW_NO_INSTALL_UPGRADE=1 "$REPO/bin/dot" install $mods || failures=$((failures + 1))
    "$REPO/bin/dot" link $mods || failures=$((failures + 1))
  fi ;;
push)
  [ $# -gt 0 ] || { echo "usage: dot push <message>" >&2; exit 1; }
  msg=$* branch=jon/$(printf %s "$*" | tr -cs '[:alnum:]' - | tr '[:upper:]' '[:lower:]' | sed 's/^-*//; s/-*$//' | cut -c1-40)
  for r in $repos; do
    [ -e "$r/.git" ] && [ -n "$(git -C "$r" status --porcelain)" ] || continue
    mod=${r##*/} idx=$(mktemp)
    # A temporary index commits the changes without touching the checkout, so they stay in use until the PR merges.
    if GIT_INDEX_FILE=$idx git -C "$r" read-tree HEAD && GIT_INDEX_FILE=$idx git -C "$r" add -A &&
      tree=$(GIT_INDEX_FILE=$idx git -C "$r" write-tree) && c=$(git -C "$r" commit-tree "$tree" -p HEAD -m "$msg") &&
      git -C "$r" push -q origin "$c:refs/heads/$branch" &&
      url=$(cd "$r" && gh pr create --head "$branch" --base main --title "$msg" --body "Local changes from $(hostname -s), pushed with \`dot push\`.")
    then say "opened $url"; else fail "could not open a PR"; fi
    rm -f "$idx"
  done ;;
*)
  echo "usage: dot link|install [module...] | dot status [--orphans | module...] | dot pull | dot push <message>" >&2; exit 1 ;;
esac
[ $failures -eq 0 ]
